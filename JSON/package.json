{
  "name": "kath",
  "private": true,
  "version": "0.0.115",
  "workspaces": [
    "applications/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @kath/extension && npm run build --workspace @kath/electron",
    "clean": "npm run clean --workspace @kath/extension && npm run clean --workspace @kath/electron",
    "start": "npm run start --workspace @kath/electron"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@theia/application-manager": "1.74.1",
    "@theia/cli": "1.74.1",
    "@theia/core": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/electron": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/navigator": "1.74.1",
    "@theia/output": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/search-in-workspace": "1.74.1",
    "@theia/task": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/workspace": "1.74.1",
    "@vscode/windows-ca-certs": "0.3.4",
    "electron": "42.3.0",
    "@theia/debug": "1.74.1"
  }
}
